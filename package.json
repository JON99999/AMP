{
  "name": "amp",
  "private": true,
  "version": "0.20.6",
  "description": "AMP - Announcement Media Player - An app designed for Radio Stations to schedule, play, read, and log announcements and drops.",
  "author": "AMP",
  "repository": {
    "type": "git",
    "url": "https://github.com/JON99999/AMP.git"
  },
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'server.js'].forEach(p => { if (fs.existsSync(p)) fs.rmSync(p, { recursive: true, force: true }) })\"",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "desktop": "npm run build && electron .",
    "dist": "node scripts/build-apps.cjs"
  },
  "build": {
    "appId": "com.amp.scheduler",
    "productName": "AMP",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "differentialPackage": false,
      "artifactName": "${productName}-${version}-Windows-Installer.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "AMP requires access to local folders to schedule, read, and log announcement audio.",
        "NSDownloadsFolderUsageDescription": "AMP requires access to your folders for audio and log storage.",
        "NSDesktopFolderUsageDescription": "AMP requires access to your selected folders.",
        "NSFileSharingEnabled": true
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-Mac.${ext}"
    }
  },
  "dependencies": {
    "express": "^4.22.3",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "firebase": "^12.19.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  }
}
